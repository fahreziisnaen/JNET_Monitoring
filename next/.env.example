# =====================================================
# JNET MONITORING - Frontend Development Environment
# =====================================================
# Copy this file to .env.local for development
# Command: cp env.local.example .env.local
# =====================================================

# =====================================================
# API ENDPOINTS (Development)
# =====================================================
# Backend API base URL (without /api prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:9494

# WebSocket URL (ws:// for development)
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:9494/ws

# CORS Origins - tambahkan domain yang diakses user
CORS_ORIGINS=https://yourwebsite.com,http://yourwebsite.com

# =====================================================
# NOTES FOR DEVELOPMENT
# =====================================================
# - Use http:// for API and ws:// for WebSocket in development
# - Make sure backend is running on port 9494
# - Frontend dev server will run on port 3000
# =====================================================

