# =====================================================
# JNET MONITORING - Backend Environment Configuration
# =====================================================
# Copy this file to .env and fill in your actual values
# Command: cp env.example .env
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jnet_monitoring

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# IMPORTANT: Generate a secure random string (minimum 32 characters)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# =====================================================
# SUPER ADMIN CONFIGURATION
# =====================================================
# Comma-separated list of User IDs that have Super Admin privileges
# Default is 1 if not set
SUPER_ADMIN_IDS=1

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=9494
# NODE_ENV=development

# Set to 'true' if behind reverse proxy (Nginx, Apache, Cloudflare)
# Required for correct IP detection and rate limiting
# BEHIND_REVERSE_PROXY=true

# =====================================================
# CORS CONFIGURATION
# =====================================================
# Comma-separated list of allowed origins (no spaces after comma)
# Development example:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =====================================================
# LOGGING CONFIGURATION (Optional)
# =====================================================
# Log level: fatal, error, warn, info, debug, trace
# Development: debug
# Production: info or warn
# LOG_LEVEL=debug
DEBUG_API=false

# =====================================================
# SECURITY NOTES
# =====================================================
# 1. NEVER commit .env file to git!
# 2. Use strong, unique JWT_SECRET in production
# 3. Change DB_PASSWORD regularly
# 4. Restrict CORS_ORIGINS in production
# 5. Set NODE_ENV=production in production
# =====================================================

# =====================================================
# QUICK START
# =====================================================
# 1. Copy this file: cp env.example .env
# 2. Generate JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Update database credentials
# 4. Set your CORS origins
# 5. Save and restart server
# =====================================================

# =====================================================
# MONITORING CONFIGURATION
# =====================================================
# POLLING_INTERVAL_MS=3000
# SECRET_REFRESH_MS=120000
# CPU_COOLDOWN_MINUTES=15
# OFFLINE_COOLDOWN_MINUTES=15
# TRAFFIC_LOG_INTERVAL_MS=60000
# DASHBOARD_UPDATE_INTERVAL_MS=15000

# =====================================================
# CRON SCHEDULES
# =====================================================
# SLA_MONITOR_CRON="*/3 * * * * *"
# DOWNTIME_NOTIFY_CRON="*/30 * * * * *"
# DB_CLEANUP_CRON="0 2 * * *"

# =====================================================
# BILLING MODULE (lihat src/billing/README.md)
# =====================================================
# Jalankan migrasi dulu: mysql -u root -p jnet_monitoring < migrations/billing_module.sql
# Masa berlaku token pelanggan (JWT pakai JWT_SECRET yg sama, audience berbeda)
# BILLING_JWT_EXPIRES=30d
# Timezone untuk scheduler billing
# BILLING_TZ=Asia/Jakarta
# Engine berjadwal (generate invoice, overdue, auto-isolir) — MATI secara default.
# Set 'true' HANYA setelah paket/pelanggan/langganan & billing_settings dikonfigurasi.
# BILLING_SCHEDULER_ENABLED=false
# Dokumentasi API billing (Scalar) di /api/billing/docs. Default AKTIF.
# Set 'false' di PRODUKSI agar tidak mengekspos surface API ke publik.
# BILLING_DOCS_ENABLED=true
# Payment Gateway Tripay (GLOBAL, satu akun untuk semua workspace).
# Kosongkan untuk mode simulasi. Set 'production' saat go-live.
# TRIPAY_MODE=sandbox
# TRIPAY_MERCHANT_CODE=
# TRIPAY_API_KEY=
# TRIPAY_PRIVATE_KEY=
# Channel pembayaran default untuk link via WA (mis. QRIS, BRIVA). Default QRIS.
# TRIPAY_DEFAULT_CHANNEL=QRIS
# Masa berlaku link pembayaran (jam). Default 24.
# TRIPAY_EXPIRY_HOURS=24

